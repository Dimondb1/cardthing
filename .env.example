# Copy to .env on the server and fill in. Never commit .env.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=ripraptor.com,www.ripraptor.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ripraptor.com,https://www.ripraptor.com
DJANGO_SQLITE_PATH=/var/lib/ripraptor/db.sqlite3
RIPRAPTOR_CONTACT_EMAIL=
RIPRAPTOR_STALE_AFTER_HOURS=72
RIPRAPTOR_USE_FEED_IMAGES=1
RIPRAPTOR_HOME_CACHE_SECONDS=300
# The cache folder the site and every command share; it must be writable by the ripraptor user.
RIPRAPTOR_CACHE_DIR=/var/lib/ripraptor/cache
# Google AdSense publisher id, for example ca-pub-1234567890123456. Empty: no adverts.
RIPRAPTOR_ADSENSE_CLIENT=
# The Claude judge on Things to check. Leave the key empty and save it from the page instead; it is then
# kept in a file beside the database that only the site can read. The page's monthly limit can never go
# above RIPRAPTOR_CLAUDE_MAX_MONTHLY_USD (US dollars).
RIPRAPTOR_CLAUDE=1
RIPRAPTOR_CLAUDE_API_KEY=
RIPRAPTOR_CLAUDE_MAX_MONTHLY_USD=25
