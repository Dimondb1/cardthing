# Copy to .env on the server and fill in. Never commit .env.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=cardscout.example,www.cardscout.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://cardscout.example,https://www.cardscout.example
DJANGO_SQLITE_PATH=/var/lib/cardscout/db.sqlite3
CARDSCOUT_CONTACT_EMAIL=
CARDSCOUT_STALE_AFTER_HOURS=72
CARDSCOUT_USE_FEED_IMAGES=1
CARDSCOUT_HOME_CACHE_SECONDS=300
