# systemd unit for the web app. Copy to /etc/systemd/system/cardscout.service
[Unit]
Description=CardScout web app
After=network.target

[Service]
User=cardscout
WorkingDirectory=/srv/cardscout
EnvironmentFile=/srv/cardscout/.env
ExecStart=/srv/cardscout/.venv/bin/gunicorn cardscout.wsgi:application --bind 127.0.0.1:8000 --workers 2
Restart=always

[Install]
WantedBy=multi-user.target
