# The background reader (deploy/ripraptor-worker.service) reads the shops all day. These lines are the floor under it:
# the hourly import and the ten-minute stock watch run only when its heartbeat is older than 30 minutes
# (--if-worker-dead 30), so the site keeps updating if it never starts. The hourly import waits up to 30 minutes
# for the import lock, which the reader holds only while a shop read is running. tidy_all runs hourly on its own
# lock and then waits up to 30 minutes for the import lock, so it never merges products while a read saves offers.
# The stock alerts run every 10 minutes whatever the reader does, check_worker hourly, price history and a
# backup nightly, delivery charges weekly. Install with: crontab deploy/crontab
# deploy/install.sh writes the same lines (it is the source of truth); catalogue/tests_ops.py fails when they differ.
# Every command runs under timeout, set to its budget plus five minutes, so a hung command cannot hold a lock for ever.
# The snapshot, the delivery check and tidy_all put timeout inside flock, so waiting for a long import does not use up their limit.
PYTHONUNBUFFERED=1
0 * * * *  cd /srv/ripraptor && set -a && . ./.env && set +a && timeout -k 60 3300 flock -w 1800 /tmp/ripraptor-import.lock .venv/bin/python manage.py import_prices --due --if-worker-dead 30 >> /var/log/ripraptor-import.log 2>&1
5 * * * *  cd /srv/ripraptor && set -a && . ./.env && set +a && flock -n /tmp/ripraptor-tidy.lock flock -w 1800 /tmp/ripraptor-import.lock timeout -k 60 1500 .venv/bin/python manage.py tidy_all >> /var/log/ripraptor-import.log 2>&1
15 0 * * * cd /srv/ripraptor && set -a && . ./.env && set +a && flock /tmp/ripraptor-import.lock timeout -k 60 1800 .venv/bin/python manage.py snapshot_daily_prices >> /var/log/ripraptor-import.log 2>&1
30 3 * * 0 cd /srv/ripraptor && set -a && . ./.env && set +a && flock /tmp/ripraptor-import.lock timeout -k 60 3000 .venv/bin/python manage.py check_delivery --apply >> /var/log/ripraptor-import.log 2>&1
*/10 * * * * cd /srv/ripraptor && set -a && . ./.env && set +a && timeout -k 30 540 flock -n /tmp/ripraptor-import.lock .venv/bin/python manage.py watch_stock --if-worker-dead 30 >> /var/log/ripraptor-import.log 2>&1
*/10 * * * * cd /srv/ripraptor && set -a && . ./.env && set +a && timeout -k 30 540 flock -n /tmp/ripraptor-alerts.lock .venv/bin/python manage.py send_stock_alerts >> /var/log/ripraptor-import.log 2>&1
20 * * * * cd /srv/ripraptor && set -a && . ./.env && set +a && timeout -k 30 600 .venv/bin/python manage.py check_worker >> /var/log/ripraptor-import.log 2>&1
40 0 * * * cd /srv/ripraptor && set -a && . ./.env && set +a && timeout -k 60 1800 .venv/bin/python manage.py backup_db --keep 5 >> /var/log/ripraptor-import.log 2>&1
45 4 5 * * cd /srv/ripraptor && set -a && . ./.env && set +a && timeout -k 60 1800 .venv/bin/python manage.py fetch_geoip >> /var/log/ripraptor-import.log 2>&1
