# Price checks every hour, price history once a day. Install with: crontab deploy/crontab
0 * * * *  cd /srv/ripraptor && .venv/bin/python manage.py import_prices >> /var/log/ripraptor-import.log 2>&1
15 0 * * * cd /srv/ripraptor && .venv/bin/python manage.py snapshot_daily_prices >> /var/log/ripraptor-import.log 2>&1
