# systemd unit for the background reader (manage.py run_worker). Copy to /etc/systemd/system/ripraptor-worker.service
# It reads the shops when their turn comes and checks popular listings every ten minutes. systemd restarts it
# when it stops, and when its heartbeat to the watchdog stops for three minutes. If it never runs, the hourly
# cron reads the shops instead (import_prices --if-worker-dead 30). Its log: journalctl -u ripraptor-worker
# install.sh copies this file on every update, so change nothing here by hand: the number of jobs it runs at
# once is RIPRAPTOR_WORKER_THREADS in .env (3 unless set; install.sh writes 2 on a server with under 1.5 GB of memory
# and takes it out again once the server is resized past that).
[Unit]
Description=RipRaptor background reader
After=network.target
# Never give up restarting it.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=ripraptor
WorkingDirectory=/srv/ripraptor
EnvironmentFile=/srv/ripraptor/.env
Environment=PYTHONUNBUFFERED=1
# At most two memory pools shared by its threads: glibc's default gives each thread its own, and memory freed in one
# is kept from the others, so a threaded reader grows. It also hands memory back after jobs and restarts itself past
# three quarters of MemoryMax (catalogue/worker.py MEMORY_SHARE) rather than reach it.
Environment=MALLOC_ARENA_MAX=2
ExecStart=/srv/ripraptor/.venv/bin/python manage.py run_worker
# It reads its code and settings but writes only its own data and the shared /tmp (the import lock it shares with
# the cron jobs), as the site does (ripraptor.service).
ProtectSystem=strict
ReadWritePaths=-/var/lib/ripraptor -/srv/ripraptor/media -/tmp -/var/tmp
Restart=always
RestartSec=10
WatchdogSec=180
# A share of the server's memory, about 300 MB on a "1 GB" server and 600 MB on a 2 GB one, so a bigger server
# gives its three jobs room without an edit here.
MemoryMax=32%
# Past its limit it may use a little swap, then it is restarted, rather than fill the swap the site relies on.
MemorySwapMax=100M
# When the whole server runs out of memory, the kernel stops the reader before the site.
OOMScoreAdjust=500
Nice=10
KillSignal=SIGINT
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
