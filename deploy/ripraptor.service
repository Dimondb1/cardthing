# systemd unit for the web app. Copy to /etc/systemd/system/ripraptor.service
[Unit]
Description=RipRaptor web app
After=network.target

[Service]
User=ripraptor
WorkingDirectory=/srv/ripraptor
EnvironmentFile=/srv/ripraptor/.env
# As python -m, so the packages' folder can be made again beside the old one and moved into place (install.sh).
# No control socket: gunicorn 25.1 added one, made in the home folder the site may not write, and logged "Control
# server error: Permission denied" at every start. Nothing here uses it.
ExecStart=/srv/ripraptor/.venv/bin/python -m gunicorn ripraptor.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 60 --no-control-socket
# The site reads its code and settings but writes only its own data and the shared /tmp (the cron jobs' locks,
# gunicorn's own files): even a break-in to it cannot change the code root later updates. install.sh owns the rest.
ProtectSystem=strict
ReadWritePaths=-/var/lib/ripraptor -/srv/ripraptor/media -/tmp -/var/tmp
Restart=always
# When memory runs out, the kernel stops background work before the site visitors use.
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
