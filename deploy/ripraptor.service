# systemd unit for the web app. Copy to /etc/systemd/system/ripraptor.service
[Unit]
Description=RipRaptor web app
After=network.target

[Service]
User=ripraptor
WorkingDirectory=/srv/ripraptor
EnvironmentFile=/srv/ripraptor/.env
ExecStart=/srv/ripraptor/.venv/bin/gunicorn ripraptor.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 60
Restart=always
# When memory runs out, the kernel stops background work before the site visitors use.
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
